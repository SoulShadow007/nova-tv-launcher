<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!-- Top bar status chip -->
    <style name="StatusChip">
        <item name="android:layout_width">wrap_content</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:background">@drawable/bg_chip</item>
        <item name="android:fontFamily">monospace</item>
        <item name="android:paddingStart">@dimen/chip_padding_h</item>
        <item name="android:paddingTop">@dimen/chip_padding_v</item>
        <item name="android:paddingEnd">@dimen/chip_padding_h</item>
        <item name="android:paddingBottom">@dimen/chip_padding_v</item>
        <item name="android:textColor">?attr/novaTextSecondary</item>
        <item name="android:textSize">14sp</item>
    </style>

    <!-- Preview panel row -->
    <style name="PreviewRow">
        <item name="android:layout_width">match_parent</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:layout_marginBottom">14dp</item>
        <item name="android:gravity">center_vertical</item>
        <item name="android:orientation">horizontal</item>
    </style>

    <style name="PreviewLabel">
        <item name="android:layout_width">170dp</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:textColor">?attr/novaTextSecondary</item>
        <item name="android:textSize">13sp</item>
        <item name="android:textAllCaps">true</item>
    </style>

    <style name="PreviewValue">
        <item name="android:layout_width">0dp</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:layout_weight">1</item>
        <item name="android:ellipsize">end</item>
        <item name="android:maxLines">1</item>
        <item name="android:textColor">?attr/novaTextPrimary</item>
        <item name="android:textSize">16sp</item>
    </style>

    <!-- Bottom bar nav button -->
    <style name="NavButton">
        <item name="android:layout_width">wrap_content</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:background">@drawable/bg_button</item>
        <item name="android:clickable">true</item>
        <item name="android:focusable">true</item>
        <item name="android:gravity">center_vertical</item>
        <item name="android:orientation">horizontal</item>
        <item name="android:paddingStart">20dp</item>
        <item name="android:paddingTop">12dp</item>
        <item name="android:paddingEnd">24dp</item>
        <item name="android:paddingBottom">12dp</item>
    </style>

    <style name="NavIcon">
        <item name="android:layout_width">22dp</item>
        <item name="android:layout_height">22dp</item>
        <item name="android:tint">?attr/novaAccent</item>
    </style>

    <style name="NavLabel">
        <item name="android:layout_width">wrap_content</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:layout_marginStart">10dp</item>
        <item name="android:textColor">?attr/novaTextPrimary</item>
        <item name="android:textSize">16sp</item>
    </style>
</resources>
